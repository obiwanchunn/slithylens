<Window x:Class="SlithyLens.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SlithyLens"
        Title="SlithyLens" Width="1100" Height="780" MinWidth="640" MinHeight="400"
        Background="#1E1E1E" Icon="app.ico" AllowDrop="True"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <DockPanel>

        <!-- toolbar -->
        <Border DockPanel.Dock="Top" Background="#2B2B2B" BorderBrush="#3A3A3A" BorderThickness="0,0,0,1" Padding="6,6">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button x:Name="OpenButton" Content="Open…" Click="Open_Click"
                            ToolTip="Open a photo (Ctrl+O). You can also drop one on the window."/>
                    <Border Width="1" Margin="8,2" Background="#4A4A4A"/>
                    <Button x:Name="JpgButton" Content="JPG" Click="Jpg_Click"
                            ToolTip="Save a full-size copy as name.jpg and open it" ToolTipService.ShowOnDisabled="True"/>
                    <Button x:Name="SmallButton" Content="Small" Click="Small_Click"
                            ToolTip="JPG ≤ 500 KB: saves name_small.jpg and opens it" ToolTipService.ShowOnDisabled="True"/>
                    <Border Width="1" Margin="8,2" Background="#4A4A4A"/>
                    <Button x:Name="CropButton" Content="Crop" Click="Crop_Click"
                            ToolTip="Crop, then save name_crop.jpg and open it in a new window"/>
                    <Button x:Name="LensButton" Content="Lens" Click="Lens_Click"
                            ToolTip="Drag four corners onto a page or whiteboard, then save it straightened as name_lens.jpg and open it in a new window"/>
                    <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" Visibility="Collapsed"
                            ToolTip="Stop cropping (Esc)"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <TextBlock x:Name="ZoomText" Foreground="#9A9A9A" VerticalAlignment="Center" Margin="0,0,8,0" MinWidth="44" TextAlignment="Right"/>
                    <Button x:Name="FitButton" Content="Fit" Click="Fit_Click" ToolTip="Fit in window (F, or click the mouse wheel)"/>
                    <Button x:Name="ActualButton" Content="1:1" Click="Actual_Click" ToolTip="Actual pixels (1)"/>
                    <Button x:Name="MenuButton" Content="⋯" Click="Menu_Click" Padding="10,5">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Add SlithyLens to Open with and Edit with (.heic, .jpg, .png)…" Click="Register_Click"/>
                                <MenuItem Header="Remove SlithyLens from Open with and Edit with" Click="Unregister_Click"/>
                                <Separator/>
                                <MenuItem Header="Keyboard and mouse help" Click="Help_Click"/>
                                <MenuItem Header="About SlithyLens" Click="About_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- status bar -->
        <Border DockPanel.Dock="Bottom" Background="#252525" BorderBrush="#3A3A3A" BorderThickness="0,1,0,0" Padding="10,4">
            <DockPanel>
                <Button x:Name="FolderButton" DockPanel.Dock="Right" Content="Show in folder" Click="Folder_Click"
                        Visibility="Collapsed" Padding="10,2" FontSize="12"/>
                <TextBlock x:Name="StatusText" Foreground="#CFCFCF" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" FontSize="12.5"/>
            </DockPanel>
        </Border>

        <local:ImageView x:Name="View"/>
    </DockPanel>
</Window>
